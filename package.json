{
  "name": "adonis6-gigya",
  "version": "1.0.0",
  "description": "Gigya SDK integration for AdonisJS v6",
  "type": "module",
  "main": "./build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./services/*": "./build/services/*.js",
    "./types": "./build/types/index.js",
    "./gigya_provider": "./build/providers/gigya_provider.js"
  },
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "engines": {
    "node": ">=18.16.0"
  },
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext=.ts",
    "format": "prettier --write .",
    "quick:test": "node build/bin/test.js",
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "prebuild": "npm run lint && npm run clean",
    "build": "tsc",
    "postbuild": "npm run copy:templates",
    "release": "np",
    "version": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "adonisjs",
    "gigya",
    "authentication",
    "customer-identity",
    "sdk"
  ],
  "author": "Russel Herrera",
  "license": "MIT",
  "devDependencies": {
    "@adonisjs/assembler": "^7.0.0",
    "@adonisjs/core": "^6.0.0",
    "@adonisjs/eslint-config": "^1.0.0",
    "@adonisjs/prettier-config": "^1.0.0",
    "@adonisjs/tsconfig": "^1.0.0",
    "@japa/assert": "^2.0.0",
    "@japa/runner": "^3.0.0",
    "@swc/core": "^1.0.0",
    "@types/node": "^20.0.0",
    "c8": "^8.0.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^5.0.0",
    "eslint": "^8.0.0",
    "np": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@adonisjs/core": "^6.0.0"
  },
  "dependencies": {
    "@cambridge-pte/gigya": "^3.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/adonis6-gigya.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/adonis6-gigya/issues"
  },
  "homepage": "https://github.com/yourusername/adonis6-gigya#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/package"
  },
  "prettier": "@adonisjs/prettier-config",
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  }
}
